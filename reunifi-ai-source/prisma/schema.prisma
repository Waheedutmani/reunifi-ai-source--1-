generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  password      String
  role          String   @default("parent") // admin, police, ngo, rescue, parent
  avatar        String?
  phone         String?
  organization  String?
  verified      Boolean  @default(false)
  active        Boolean  @default(true)
  lastLogin     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  missingReports  MissingChild[]  @relation("Reporter")
  foundReports    FoundChild[]    @relation("Registrar")
  assignedCases   Case[]          @relation("AssignedOfficer")
  verifiedMatches MatchResult[]   @relation("Verifier")
  notifications   Notification[]  @relation("NotifiedUser")
  auditLogs       AuditLog[]      @relation("AuditUser")
}

model MissingChild {
  id                  String   @id @default(cuid())
  fullName            String
  age                 Int
  gender              String
  lastSeenLocation    String
  lastSeenDate        DateTime
  dateMissing         DateTime
  clothingDescription String?
  medicalConditions   String?
  emergencyContact    String?
  parentGuardianName  String
  parentGuardianPhone String
  parentGuardianEmail String?
  photos              String   @default("[]") // JSON array of photo URLs
  status              String   @default("open") // open, investigating, matched, closed
  priority            String   @default("normal") // normal, high, critical
  caseNumber          String   @unique
  reportedBy          String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  reporter   User          @relation("Reporter", fields: [reportedBy], references: [id])
  matches    MatchResult[]  @relation("MissingMatch")
  cases      Case[]         @relation("MissingCase")
}

model FoundChild {
  id                  String   @id @default(cuid())
  estimatedName       String?
  estimatedAge        Int
  gender              String
  foundLocation       String
  foundDate           DateTime
  healthStatus        String   @default("stable") // stable, critical, injured
  rescueDetails       String?
  shelterInfo         String?
  identificationMarks String?
  photos              String   @default("[]") // JSON array of photo URLs
  status              String   @default("unidentified") // unidentified, identified, reunited
  registeredBy        String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  registrar User          @relation("Registrar", fields: [registeredBy], references: [id])
  matches   MatchResult[]  @relation("FoundMatch")
}

model MatchResult {
  id                String   @id @default(cuid())
  missingChildId    String
  foundChildId      String
  similarityScore   Float
  confidence        String   @default("medium") // low, medium, high
  verified          Boolean  @default(false)
  verifiedBy        String?
  verificationNotes String?
  status            String   @default("pending") // pending, confirmed, rejected
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  missingChild  MissingChild @relation("MissingMatch", fields: [missingChildId], references: [id])
  foundChild    FoundChild   @relation("FoundMatch", fields: [foundChildId], references: [id])
  verifier      User?        @relation("Verifier", fields: [verifiedBy], references: [id])
  cases         Case[]       @relation("MatchCase")
}

model Case {
  id             String   @id @default(cuid())
  caseNumber     String   @unique
  title          String
  status         String   @default("open") // open, investigating, matched, closed
  priority       String   @default("normal") // normal, high, critical
  notes          String   @default("[]") // JSON array of timeline notes
  assignedTo     String?
  missingChildId String?
  matchResultId  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assignedOfficer User?         @relation("AssignedOfficer", fields: [assignedTo], references: [id])
  missingChild    MissingChild? @relation("MissingCase", fields: [missingChildId], references: [id])
  matchResult     MatchResult?  @relation("MatchCase", fields: [matchResultId], references: [id])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  title       String
  message     String
  type        String   @default("info") // info, alert, match, emergency
  read        Boolean  @default(false)
  relatedId   String?
  relatedType String?  // missing, found, match, case
  createdAt   DateTime @default(now())

  user User @relation("NotifiedUser", fields: [userId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation("AuditUser", fields: [userId], references: [id])
}
